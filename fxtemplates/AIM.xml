.inference.Operator.weight,    beast.base.evolution.speciation.YuleModel.treeIntervals,    beast.base.evolution.speciation.YuleModel.useTipDates,    beast.base.evolution.speciation.YuleModel.tree,    beast.base.inference.Logger.model,    starbeast2.GeneTreeWithMigration.tree,    starbeast2.GeneTreeWithMigration.populationModel,    starbeast2.UncorrelatedRates.rates,    starbeast2.UncorrelatedRates.noCache,    starbeast2.RandomLocalRates.rates,    starbeast2.RandomLocalRates.noCache,    starbeast2.ConstantWithGeneFlow.migrationModel" buttonLabelMap="beast.app.beauti.BeautiInitDlg.&gt;&gt; details=Edit parameters">

