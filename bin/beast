#!/bin/sh
# Run BEAST3 against a starbeast2 XML.
#
# Delegates to the exec-maven-plugin already configured in pom.xml, so Maven
# resolves the full module path (beast-base, beast-fx, SA, MM, guava,
# commons-math3, ...) straight from pom.xml's own dependency graph. No
# manual jar paths, no separate ../beast3 build.
#
# Usage:
#   bin/beast path/to/file.xml
#   bin/beast -help

# Finds the absolute path of the directory one level above where this script (bin/beast).
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 path/to/file.xml or $0 -help" >&2
    exit 1
fi

# Changes the current working directory to the project's root folder
cd "$PROJECT_ROOT"
# Compiles and runs beast using Maven, and pass a system property named beast.args to Java.
exec mvn -q compile exec:exec -Dbeast.args="$*"
