		<partitiontemplate id="StarBEASTPartitionTemplate" spec="beastfx.app.inputeditor.BeautiSubTemplate" class="beast.base.spec.evolution.likelihood.TreeLikelihood" mainid="mcmc"><![CDATA[<geneTree id="geneTree.t:$(n)" ploidy="2.0" spec="starbeast2.GeneTreeWithMigration" populationModel="@popModelAIM.Species" tree="@Tree.t:$(n)"/>

			<stateNode id="strictClockRate.c:$(n)" value="1.0" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>

			<!-- site model -->
			<plugin spec="beast.base.spec.evolution.sitemodel.SiteModel" id="SiteModel.s:$(n)" gammaCategoryCount="0">
				<!--substModel will be automatically detected /-->
				<proportionInvariant id="proportionInvariant.s:$(n)" value="0.0" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval"/>
				<mutationRate id="mutationRate.s:$(n)" value="1.0" estimate="true" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
				<shape id="gammaShape.s:$(n)" value="1.0" estimate="false" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real"/>
			</plugin>

			<plugin spec="beast.base.spec.evolution.likelihood.TreeLikelihood" id="treeLikelihood.$(n)">
				<data idref="data"/>
				<tree idref="Tree.t:$(n)"/>
				<siteModel idref="SiteModel.s:$(n)"/>
				<branchRateModel id="StrictClock.c:$(n)" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel" clock.rate="@strictClockRate.c:$(n)"/>
			</plugin>

			<!-- tree and its properties -->
			<taxonset id="TaxonSet.$(n)" spec="beast.base.evolution.alignment.TaxonSet" alignment="@$(n)"/>
			<plugin spec="beast.base.evolution.tree.Tree" id="Tree.t:$(n)" taxonset="@TaxonSet.$(n)"/>

			<plugin id="TreeHeight.t:$(n)" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:$(n)"/>

			<distribution id="MutationRatePrior.s:$(n)" spec="beast.base.spec.inference.distribution.Uniform" param="@mutationRate.s:$(n)"/>

			<distribution id="GammaShapePrior.s:$(n)" spec="beast.base.spec.inference.distribution.LogNormal" param="@gammaShape.s:$(n)" meanInRealSpace="true" M="1.0" S="2.0"/>

			<distribution id="PropInvariantPrior.t:$(n)" spec="beast.base.spec.inference.distribution.Uniform" param="@proportionInvariant.s:$(n)" lower="0.0" upper="1.0"/>

			<operator id="proportionInvariantScaler.s:$(n)" scaleFactor="0.75" weight="1.0" parameter="@proportionInvariant.s:$(n)" spec="beast.base.spec.inference.operator.ScaleOperator"/>
			<operator id="mutationRateScaler.s:$(n)" scaleFactor="0.75" weight="1.0" parameter="@mutationRate.s:$(n)" spec="beast.base.spec.inference.operator.ScaleOperator"/>
			<operator id="gammaShapeScaler.s:$(n)" scaleFactor="0.75" weight="1.0" parameter="@gammaShape.s:$(n)" spec="beast.base.spec.inference.operator.ScaleOperator"/>
			<operator id="clockRateScaler.c:$(n)" scaleFactor="0.5" weight="3.0" parameter="@strictClockRate.c:$(n)" spec="beast.base.spec.inference.operator.ScaleOperator"/>
			<upDownOperator id="clockUpDownOperator.c:$(n)" spec="beast.base.spec.evolution.operator.UpDownOperator" scaleFactor="0.95" weight="3.0">
				<down idref="Tree.t:$(n)"/>
			</upDownOperator>

			<operator id="TreeScaler.t:$(n)" scaleFactor="0.95" weight="3.0" tree="@Tree.t:$(n)" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>
			<operator id="TreeRootScaler.t:$(n)" scaleFactor="0.7" weight="3.0" tree="@Tree.t:$(n)" rootOnly="true" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>
			<operator id="UniformOperator.t:$(n)" weight="15.0" tree="@Tree.t:$(n)" spec="beast.base.evolution.operator.Uniform"/>
			<operator id="SubtreeSlide.t:$(n)" spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" weight="15.0" size="0.002" tree="@Tree.t:$(n)"/>
			<operator id="Narrow.t:$(n)" spec="Exchange" isNarrow="true" weight="15.0" tree="@Tree.t:$(n)"/>
			<operator id="Wide.t:$(n)" spec="Exchange" isNarrow="false" weight="15.0" tree="@Tree.t:$(n)"/>
			<operator id="WilsonBalding.t:$(n)" spec="WilsonBalding" weight="15.0" tree="@Tree.t:$(n)"/>

			<logger id="treelog.t:$(n)" spec="beast.base.inference.Logger" logEvery="5000" fileName="$(tree).trees" mode="tree">
				<log id="TreeWithMetaDataLogger.t:$(n)" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:$(n)"/>
			</logger>


			]]><connect srcID="treeLikelihood.$(n)" targetID="likelihood" inputName="distribution" if="isInitializing"/><![CDATA[

			]]><connect srcID="treelog.t:$(n)" targetID="mcmc" inputName="logger" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[

			]]><connect srcID="geneTree.t:$(n)" targetID="speciescoalescent" inputName="distribution" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><!-- hack to ensure that treePrior.$(n) is always deleted from prior, since it is already part of speciescoalescent --><![CDATA[
			]]><connect srcID="geneTree.t:$(n)" targetID="prior" inputName="distribution" if="Tree.t:$(n)/estimate=XXX"/><![CDATA[

			]]><!-- when FixMeanMutationRatesOperator, the prior is uniform due to the operator --><![CDATA[
			]]><connect srcID="MutationRatePrior.s:$(n)" targetID="prior" inputName="distribution" if="nooperator(FixMeanMutationRatesOperator) and inposterior(mutationRate.s:$(n)) and mutationRate.s:$(n)/estimate=true"/><![CDATA[

			]]><connect srcID="Tree.t:$(n)" targetID="state" inputName="stateNode" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="proportionInvariant.s:$(n)" targetID="state" inputName="stateNode" if="inposterior(proportionInvariant.s:$(n)) and proportionInvariant.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="mutationRate.s:$(n)" targetID="state" inputName="stateNode" if="inposterior(mutationRate.s:$(n)) and mutationRate.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="gammaShape.s:$(n)" targetID="state" inputName="stateNode" if="inposterior(gammaShape.s:$(n)) and gammaShape.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="strictClockRate.c:$(n)" targetID="state" inputName="stateNode" if="inposterior(Tree.t:$(n)) and strictClockRate.c:$(n)/estimate=true"/><![CDATA[

			]]><connect srcID="proportionInvariantScaler.s:$(n)" targetID="mcmc" inputName="operator" if="inposterior(proportionInvariant.s:$(n)) and proportionInvariant.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="mutationRateScaler.s:$(n)" targetID="mcmc" inputName="operator" if="inposterior(mutationRate.s:$(n)) and mutationRate.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="gammaShapeScaler.s:$(n)" targetID="mcmc" inputName="operator" if="inposterior(gammaShape.s:$(n)) and gammaShape.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="clockRateScaler.c:$(n)" targetID="mcmc" inputName="operator" if="inposterior(strictClockRate.c:$(n)) and strictClockRate.c:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="clockUpDownOperator.c:$(n)" targetID="mcmc" inputName="operator" if="inlikelihood(Tree.t:$(n)) and Tree.t:$(n)/estimate=true">
				Scale up substitution rate c:$(n) and scale down tree t:($n)
			</connect><![CDATA[

			]]><connect srcID="TreeScaler.t:$(n)" targetID="mcmc" inputName="operator" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="TreeRootScaler.t:$(n)" targetID="mcmc" inputName="operator" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="UniformOperator.t:$(n)" targetID="mcmc" inputName="operator" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="SubtreeSlide.t:$(n)" targetID="mcmc" inputName="operator" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="Narrow.t:$(n)" targetID="mcmc" inputName="operator" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="Wide.t:$(n)" targetID="mcmc" inputName="operator" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="WilsonBalding.t:$(n)" targetID="mcmc" inputName="operator" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[

			]]><connect srcID="treeLikelihood.$(n)" targetID="tracelog" inputName="log" if="inlikelihood(treeLikelihood.$(n))"/><![CDATA[
			]]><connect srcID="treePrior.t:$(n)" targetID="tracelog" inputName="log" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="TreeHeight.t:$(n)" targetID="tracelog" inputName="log" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="proportionInvariant.s:$(n)" targetID="tracelog" inputName="log" if="inlikelihood(proportionInvariant.s:$(n)) and proportionInvariant.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="mutationRate.s:$(n)" targetID="tracelog" inputName="log" if="inlikelihood(mutationRate.s:$(n)) and mutationRate.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="gammaShape.s:$(n)" targetID="tracelog" inputName="log" if="inlikelihood(gammaShape.s:$(n)) and gammaShape.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="strictClockRate.c:$(n)" targetID="tracelog" inputName="log" if="inlikelihood(strictClockRate.c:$(n)) and strictClockRate.c:$(n)/estimate=true"/><![CDATA[

			]]><connect srcID="GammaShapePrior.s:$(n)" targetID="prior" inputName="distribution" if="inlikelihood(gammaShape.s:$(n)) and gammaShape.s:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="PropInvariantPrior.s:$(n)" targetID="prior" inputName="distribution" if="inlikelihood(proportionInvariant.s:$(n)) and proportionInvariant.s:$(n)/estimate=true"/><![CDATA[

			]]><connect srcID="Tree.t:$(n)" targetID="coordinatedUniform.t:Species" inputName="geneTree" if="Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="Tree.t:$(n)" targetID="coordinatedExponential.t:Species" inputName="geneTree" if="Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="Tree.t:$(n)" targetID="updownAll:Species" inputName="down" if="inposterior(Tree.t:$(n)) and Tree.t:$(n)/estimate=true"/><![CDATA[
			]]><connect srcID="strictClockRate.c:$(n)" targetID="updownAll:Species" inputName="up" if="inlikelihood(strictClockRate.c:$(n)) and strictClockRate.c:$(n)/estimate=true"/><![CDATA[

			]]><!--
			Since "Species" is treated as a separate partition, we need the following
			hacks to get rid of undesirable Tree.t:Species connections
			--><![CDATA[
			]]><connect srcID="Tree.t:Species" targetID="coordinatedUniform.t:Species" inputName="geneTree" if="Tree.t:$(n)/estimate=XXX"/><![CDATA[
			]]><connect srcID="Tree.t:Species" targetID="coordinatedExponential.t:Species" inputName="geneTree" if="Tree.t:$(n)/estimate=XXX"/><![CDATA[
			]]><!-- end hacks --><![CDATA[

			]]><connect srcID="speciationRate.t:Species" targetID="updownAll:Species" inputName="up" if="inposterior(speciationRate.t:Species) and speciationRate.t:Species/estimate=true"/><![CDATA[

			]]><connect srcID="SBI" targetID="mcmc" inputName="init" if="inposterior(Tree.t:Species)"/><![CDATA[
			]]><connect srcID="Tree.t:$(n)" targetID="SBI" inputName="geneTree" if="inposterior(Tree.t:$(n))"/><![CDATA[
			]]><connect srcID="Tree.t:Species" targetID="SBI" inputName="geneTree" if="Tree.t:$(n)/estimate=XXX"/><![CDATA[ ]]><!-- another hack --><![CDATA[
